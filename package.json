{
  "name": "git-charm",
  "displayName": "GitCharm — IDEA Git Log & Graph",
  "description": "%ext.description%",
  "version": "0.0.5",
  "publisher": "liugui",
  "icon": "resources/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Git0gui/gitcharm.git"
  },
  "bugs": {
    "url": "https://github.com/Git0gui/gitcharm/issues"
  },
  "keywords": [
    "git",
    "charm",
    "log",
    "graph",
    "blame",
    "rebase",
    "cherry-pick"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "SCM Providers",
    "Visualization"
  ],
  "activationEvents": [
    "workspaceContains:.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "idea-git.openFileDiff",
        "title": "%cmd.openFileDiff%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.compareFileWithBranch",
        "title": "%cmd.compareFileWithBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.createBranch",
        "title": "%cmd.createBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.checkoutBranch",
        "title": "%cmd.checkoutBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.showCommitDiff",
        "title": "%cmd.showCommitDiff%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.deleteBranch",
        "title": "%cmd.deleteBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.renameBranch",
        "title": "%cmd.renameBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.mergeBranch",
        "title": "%cmd.mergeBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.rebaseOnto",
        "title": "%cmd.rebaseOnto%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.pushBranch",
        "title": "%cmd.pushBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.pullBranch",
        "title": "%cmd.pullBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.fetch",
        "title": "%cmd.fetch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.compareBranch",
        "title": "%cmd.compareBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.newBranchFrom",
        "title": "%cmd.newBranchFrom%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.cherryPick",
        "title": "%cmd.cherryPick%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.interactiveRebase",
        "title": "%cmd.interactiveRebase%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.dropCommit",
        "title": "%cmd.dropCommit%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.editCommitMessage",
        "title": "%cmd.editCommitMessage%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.squashCommits",
        "title": "%cmd.squashCommits%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.resetToCommit",
        "title": "%cmd.resetToCommit%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.toggleBlame",
        "title": "%cmd.toggleBlame%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.revealCommit",
        "title": "%cmd.revealCommit%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.updateBranch",
        "title": "%cmd.updateBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.commitBranch",
        "title": "%cmd.commitBranch%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.viewFileHistory",
        "title": "%cmd.viewFileHistory%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.initRepository",
        "title": "%cmd.initRepository%",
        "category": "GitCharm"
      },
      {
        "command": "idea-git.scmStage",
        "title": "%cmd.scmStage%",
        "category": "GitCharm",
        "icon": "$(plus)"
      },
      {
        "command": "idea-git.scmUnstage",
        "title": "%cmd.scmUnstage%",
        "category": "GitCharm",
        "icon": "$(dash)"
      },
      {
        "command": "idea-git.scmDiscard",
        "title": "%cmd.scmDiscard%",
        "category": "GitCharm",
        "icon": "$(trash)"
      },
      {
        "command": "idea-git.scmStageAll",
        "title": "%cmd.scmStageAll%",
        "category": "GitCharm",
        "icon": "$(plus)"
      },
      {
        "command": "idea-git.scmUnstageAll",
        "title": "%cmd.scmUnstageAll%",
        "category": "GitCharm",
        "icon": "$(dash)"
      },
      {
        "command": "idea-git.scmDiscardAll",
        "title": "%cmd.scmDiscardAll%",
        "category": "GitCharm",
        "icon": "$(trash)"
      },
      {
        "command": "idea-git.scmRefresh",
        "title": "%cmd.scmRefresh%",
        "category": "GitCharm",
        "icon": "$(refresh)"
      }
    ],
    "viewsContainers": {
      "panel": [
        {
          "id": "idea-git-explorer",
          "title": "GitCharm",
          "icon": "resources/git-icon.svg"
        }
      ]
    },
    "views": {
      "idea-git-explorer": [
        {
          "id": "idea-git.mainView",
          "name": "Git Log",
          "type": "webview",
          "icon": "resources/git-icon.svg"
        }
      ]
    },
    "submenus": [
      {
        "id": "idea-git.editorSubmenu",
        "label": "%submenu.gitcharm%"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "idea-git.editorSubmenu",
          "when": "resourceScheme == file",
          "group": "navigation@90"
        },
        {
          "command": "idea-git.toggleBlame",
          "when": "resourceScheme == file",
          "group": "navigation@50"
        }
      ],
      "editor/lineNumber/context": [
        {
          "command": "idea-git.toggleBlame",
          "when": "resourceScheme == file",
          "group": "navigation@1"
        }
      ],
      "idea-git.editorSubmenu": [
        {
          "command": "idea-git.compareFileWithBranch",
          "when": "resourceScheme == file",
          "group": "1_compare@1"
        },
        {
          "command": "idea-git.viewFileHistory",
          "when": "resourceScheme == file",
          "group": "3_history@1"
        }
      ],
      "commandPalette": [
        {
          "command": "idea-git.initRepository",
          "when": "!idea-git.hasGitRepo"
        },
        {
          "command": "idea-git.revealCommit",
          "when": "false"
        },
        {
          "command": "idea-git.updateBranch",
          "when": "false"
        },
        {
          "command": "idea-git.commitBranch",
          "when": "false"
        },
        {
          "command": "idea-git.dropCommit",
          "when": "false"
        },
        {
          "command": "idea-git.editCommitMessage",
          "when": "false"
        },
        {
          "command": "idea-git.scmStage",
          "when": "false"
        },
        {
          "command": "idea-git.scmUnstage",
          "when": "false"
        },
        {
          "command": "idea-git.scmDiscard",
          "when": "false"
        },
        {
          "command": "idea-git.scmStageAll",
          "when": "false"
        },
        {
          "command": "idea-git.scmUnstageAll",
          "when": "false"
        },
        {
          "command": "idea-git.scmDiscardAll",
          "when": "false"
        }
      ],
      "scm/title": [
        {
          "command": "idea-git.scmRefresh",
          "when": "scmProvider == idea-git",
          "group": "navigation"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "idea-git.scmStageAll",
          "when": "scmProvider == idea-git && scmResourceGroup == gitcharm-workingTree",
          "group": "inline@1"
        },
        {
          "command": "idea-git.scmDiscardAll",
          "when": "scmProvider == idea-git && scmResourceGroup == gitcharm-workingTree",
          "group": "inline@2"
        },
        {
          "command": "idea-git.scmUnstageAll",
          "when": "scmProvider == idea-git && scmResourceGroup == gitcharm-staged",
          "group": "inline@1"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "idea-git.scmStage",
          "when": "scmProvider == idea-git && scmResourceGroup == gitcharm-workingTree",
          "group": "1@1"
        },
        {
          "command": "idea-git.scmDiscard",
          "when": "scmProvider == idea-git && scmResourceGroup == gitcharm-workingTree",
          "group": "1@2"
        },
        {
          "command": "idea-git.scmUnstage",
          "when": "scmProvider == idea-git && scmResourceGroup == gitcharm-staged",
          "group": "1@1"
        },
        {
          "command": "idea-git.scmUnstage",
          "when": "scmProvider == idea-git && scmResourceGroup == gitcharm-unmerged",
          "group": "1@1"
        }
      ],
      "explorer/context": [
        {
          "command": "idea-git.compareFileWithBranch",
          "when": "resourceScheme == file",
          "group": "navigation@100"
        },
        {
          "command": "idea-git.viewFileHistory",
          "when": "resourceScheme == file",
          "group": "navigation@101"
        }
      ]
    },
    "configuration": {
      "title": "GitCharm",
      "properties": {
        "idea-git.cache.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.cacheEnabled%"
        },
        "idea-git.scm.enabled": {
          "type": "boolean",
          "default": true,
          "description": "%config.scmEnabled%"
        },
        "idea-git.pullStrategy": {
          "type": "string",
          "default": "merge",
          "enum": [
            "merge",
            "rebase"
          ],
          "enumDescriptions": [
            "%config.pullStrategy.merge%",
            "%config.pullStrategy.rebase%"
          ],
          "description": "%config.pullStrategy%"
        },
        "idea-git.language": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "zh-cn",
            "en"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.zh-cn%",
            "%config.language.en%"
          ],
          "description": "%config.language%"
        },
        "idea-git.debug": {
          "type": "boolean",
          "default": false,
          "description": "%config.debug%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run lint && npm test",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "watch:fast": "tsc -watch -p ./ --preserveWatchOutput",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "node --test \"out/test/*.test.js\"",
    "package": "vsce package --no-yarn"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
